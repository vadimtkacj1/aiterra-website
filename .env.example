# Copy to .env on the server. docker-compose loads ./.env for build args
# (NEXT_PUBLIC_*) and runtime env (everything else). Never commit the real .env.

# --- Build-time (inlined into the client bundle by Next at build) ---
# Google Analytics 4 measurement id. Without it the GA tag never renders.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Maps Embed API key for the contact map. NEXT_PUBLIC_* is inlined at build
# time, so it must also reach `docker build` as an arg (see compose args).
# Restrict it in Google Cloud to Maps Embed API + this site's referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional API base used by the client build.
NEXT_PUBLIC_API_URL=

# --- Admin ---
# Password for /admin login (defaults to "admin123" if unset — set a real one!).
ADMIN_PASSWORD=change-me

# --- Public lead forms (/api/site-leads/submit) ---
# Token attached to site form submissions (any non-empty value works).
NEXT_PUBLIC_SITE_LEADS_TOKEN=aiterra-website

# Lead-notification email (SMTP). With SMTP_HOST set, every form submission is
# emailed to LEAD_NOTIFY_TO. Left blank, submissions are still saved to
# data/site-leads.json and listed in /admin/leads — only the email is skipped.
#
# Production uses the Google Workspace SMTP relay, which authenticates the
# server by IP allowlist (Admin Console → Apps → Gmail → Routing → SMTP relay),
# so SMTP_USER/SMTP_PASS stay empty. For a plain mailbox instead, use
# smtp.gmail.com + the mailbox login and a 16-char App Password.
# Note: the host firewall only allows outbound 587 — 465 and 25 are blocked.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587            # 465 for SSL, 587 for STARTTLS
SMTP_SECURE=false        # true only for port 465
SMTP_USER=               # leave empty for the IP-allowlisted relay
SMTP_PASS=               # leave empty for the IP-allowlisted relay
LEAD_NOTIFY_TO=michael@aiterra.co.il
LEAD_NOTIFY_FROM=        # must be an address in aiterra.co.il; falls back to SMTP_USER, then to LEAD_NOTIFY_TO
