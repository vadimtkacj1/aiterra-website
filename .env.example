# Copy to .env on the server. docker-compose loads ./.env for build args
# (NEXT_PUBLIC_*) and runtime env (everything else). Never commit the real .env.

# --- Build-time (inlined into the client bundle by Next at build) ---
# Google Analytics 4 measurement id. Without it the GA tag never renders.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Optional API base used by the client build.
NEXT_PUBLIC_API_URL=

# --- Admin ---
# Password for /admin login (defaults to "admin123" if unset — set a real one!).
ADMIN_PASSWORD=change-me

# --- Public lead forms (/api/site-leads/submit) ---
# Token attached to site form submissions (any non-empty value works).
NEXT_PUBLIC_SITE_LEADS_TOKEN=aiterra-website

# Lead-notification email (SMTP). When these are set, every form submission is
# emailed to LEAD_NOTIFY_TO. If left blank, submissions are still saved to
# data/site-leads.json but no email is sent.
SMTP_HOST=               # e.g. smtp.gmail.com / mail.your-host.co.il
SMTP_PORT=587            # 465 for SSL, 587 for STARTTLS
SMTP_SECURE=false        # true only for port 465
SMTP_USER=               # the mailbox login, e.g. info@aiterra.co.il
SMTP_PASS=               # mailbox / app password
LEAD_NOTIFY_TO=info@aiterra.co.il
LEAD_NOTIFY_FROM=        # defaults to SMTP_USER if blank
