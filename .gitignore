# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/

# production
build/

# env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# customer leads — written at runtime, holds phone numbers and emails.
# The rest of data/ is seed content and stays tracked.
data/site-leads.json

# /v2 text overrides — written at runtime by the admin panel.
# The defaults live in src/app/v2/content.ts, so this file only holds edits.
data/v2-content.json

# misc
.DS_Store
*.pem
Thumbs.db

# editor
.vscode/
.idea/

# typescript
*.tsbuildinfo
next-env.d.ts

# Heavy source clips from the /v2 shoot. Only the compressed v2-* files ship —
# footer.mp4 is byte-identical to v2-hero.mp4's source at 36MB.
public/images/*.mp4
public/videos/*.mp4
!public/videos/v2-hero.mp4
!public/videos/v2-stats.mp4
